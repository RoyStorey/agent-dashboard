{
  "name": "agent-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local command center for running a business with a team of AI agents: owner to-dos, agent integrations, guardrails and funding.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "serve": "npm run build && npm start",
    "test": "tsx --test \"server/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent:example": "tsx examples/claude-agent.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.8"
  }
}
